{
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^next$" }]
  },
  "overrides": [
    {
      "files": ["frontend/**/*.js"],
      "env": { "browser": true }
    }
  ],
  "ignorePatterns": ["node_modules/", "coverage/"]
}
